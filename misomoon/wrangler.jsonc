// Generated by apps/api/scripts/bundle.ts from misomoon 0.1.0. Configuration: docs/configuration.md
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "misomoon",
	"main": "worker/index.js",
	"no_bundle": true,
	"find_additional_modules": true,
	"base_dir": "worker",
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.min.js"
			],
			"fallthrough": true
		}
	],
	"compatibility_date": "2026-10-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": false
		},
		"traces": {
			"enabled": false
		}
	},
	"assets": {
		"directory": "public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "CONTROL",
			"database_name": "misomoon-control",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations/control"
		},
		{
			"binding": "SHARD_0",
			"database_name": "misomoon-shard-0",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "migrations/shard"
		},
		{
			"binding": "SHARD_1",
			"database_name": "misomoon-shard-1",
			"database_id": "00000000-0000-0000-0000-000000000002",
			"migrations_dir": "migrations/shard"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "EVENTS",
				"queue": "misomoon-events"
			}
		],
		"consumers": [
			{
				"queue": "misomoon-events",
				"max_batch_size": 100,
				"max_batch_timeout": 5,
				"max_retries": 10,
				"dead_letter_queue": "misomoon-events-dlq"
			}
		]
	},
	"ratelimits": [
		{
			"name": "STATS_LIMIT",
			"namespace_id": "1002",
			"simple": {
				"limit": 100,
				"period": 60
			}
		}
	],
	"browser": {
		"binding": "BROWSER"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		"SHARD_SOFT_LIMIT_MB": "8000",
		"RETENTION_DAYS": "0",
		"RETENTION_DEFAULT_DAYS": "",
		"DEMO_SITE": "",
		"SAMPLE_SITE": "",
		"SIGNUPS": "invite"
	}
}
